		{
			"name": "Authentication",
			"item": [
				{
					"name": "1. Register User",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"testuser@example.com\",\n    \"phone_number\": \"+919876543299\",\n    \"password\": \"SecurePass@123\",\n    \"confirm_password\": \"SecurePass@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register", ""]
						}
					}
				},
				{
					"name": "2. Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data.tokens) {",
									"    pm.collectionVariables.set('accessToken', jsonData.data.tokens.access);",
									"    pm.collectionVariables.set('refreshToken', jsonData.data.tokens.refresh);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"rahul\",\n    \"password\": \"Password@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login", ""]
						}
					}
				},
				{
					"name": "3. Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data.tokens) {",
									"    pm.collectionVariables.set('accessToken', jsonData.data.tokens.access);",
									"    pm.collectionVariables.set('refreshToken', jsonData.data.tokens.refresh);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"Admin@12345\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login", ""]
						}
					}
				},
				{
					"name": "4. Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/refresh/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "refresh", ""]
						}
					}
				},
				{
					"name": "5. Set Transaction PIN",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
						},
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"pin\": \"1234\",\n    \"confirm_pin\": \"1234\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/set-pin/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "set-pin", ""]
						}
					}
				},
				{
					"name": "6. Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
						},
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/logout/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "logout", ""]
						}
					}
				}
