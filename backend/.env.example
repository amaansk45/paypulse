# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Sandbox Payment Gateway
PAYMENT_GATEWAY_KEY=sandbox_pk_paypulse_test_992147
PAYMENT_GATEWAY_SECRET=sandbox_sk_paypulse_secret_448102
PAYMENT_GATEWAY_WEBHOOK_SECRET=sandbox_whsec_paypulse_992381

# Security & OTP Policies
OTP_EXPIRY_MINUTES=10
