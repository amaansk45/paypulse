ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL URL e.g. postgresql://user:pass@localhost:5432/dbname. If empty or not reachable, defaults to SQLite)
